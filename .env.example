# ==============================================================================
# SMART RESTAURANT POS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Target Region: South Asia (Mumbai) — AWS ap-south-1
# Canonical Backend: Supabase Cloud (PostgreSQL 15+, Auth, RLS, Storage)
#
# INSTRUCTIONS:
# 1. Copy this template to .env.local:
#      copy .env.example .env.local
# 2. Fill in your project credentials from your Supabase Project Settings > API.
# 3. NEVER commit .env or .env.local to Git. Keep credentials strictly confidential.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development

# ------------------------------------------------------------------------------
# SUPABASE CANONICAL CONFIGURATION
# ------------------------------------------------------------------------------
# Canonical Supabase Project URL (e.g., https://xxxxxxxxxxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Project Region (Informational / Deployment Reference)
SUPABASE_PROJECT_REGION=ap-south-1

# Supabase Publishable / Anon Key (CLIENT-SAFE)
# - Used by Flutter POS apps (Windows/Android), KDS, Owner App, and Next.js client.
# - Safe to distribute in client bundles because database access is constrained by RLS.
# - NEVER grants administrative bypass privileges.
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Supabase Secret / Service Role Key (SERVER-SIDE ONLY — HIGH RISK)
# - CRITICAL SECURITY RULE: NEVER include this in Flutter mobile/desktop apps, browser code,
#   public client builds, or Git repositories.
# - Used EXCLUSIVELY by backend workers, trusted edge functions, and server-side admin tasks.
# - Bypasses Row Level Security (RLS) entirely!
SUPABASE_SECRET_KEY=your-supabase-secret-service-role-key

# ------------------------------------------------------------------------------
# FRONTEND FRAMEWORK COMPATIBILITY ALIASES (Next.js / Web Admin)
# ------------------------------------------------------------------------------
# Next.js requires the NEXT_PUBLIC_ prefix for variables accessible in browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
